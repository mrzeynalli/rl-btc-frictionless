{
  "protocol_version": "btc_spot_buy_sell_hold_v3_1m",
  "market": "Binance BTCUSDT Spot",
  "observation": "60 completed one-minute bars plus 10 causal hourly features",
  "decision_frequency": "hourly",
  "execution": "next hour open",
  "actions": ["BUY", "SELL", "HOLD"],
  "inventory_states": ["CASH", "BTC"],
  "funding": false,
  "reward": "100 * log(1 + position * open-to-open return - 0.0004 * abs(position change))",
  "downside_reward_penalty": false,
  "train_period": ["2017-08-17", "2026-01-01"],
  "test_period": ["2026-01-01", "2026-07-22"],
  "test_access": "only after all five training runs complete; previously exposed at project level",
  "seeds": [11, 29, 47, 71, 101],
  "updates_per_seed": 225,
  "ensemble": "equal-weight mean of position-independent seed logits",
  "encoder": "GRU, hidden size 32",
  "critic_mode": "detached shared market representation plus 7 portfolio features",
  "ppo": {
    "environments": 32,
    "rollout_steps": 128,
    "minibatches": 2,
    "actor_epochs": 4,
    "extra_critic_epochs": 4,
    "gamma": 0.95,
    "gae_lambda": 0.95,
    "actor_learning_rate": 0.0003,
    "critic_learning_rate": 0.0001,
    "adaptive_entropy": true,
    "entropy_start": 0.02,
    "entropy_target_fraction_of_log2": 0.60,
    "entropy_adaptation_rate": 0.05,
    "entropy_coefficient_bounds": [0.005, 0.05],
    "burn_in_hours": 240
  },
  "cost_sensitivity_bp_one_way": [4, 6, 8, 10]
}
