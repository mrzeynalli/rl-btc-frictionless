# The repository publishes only the source of the latest agent (simple_agent, v4): the agent package, the data
# collector and feature pipeline, the scripts that produced the reported results, and their tests.
# Everything else is ignored by default: market data, results and model weights, archived agents (backup/),
# the paper, reference articles, and agent instruction or working documents (CLAUDE.md, AGENTS.md, ARCHITECTURE.md,
# literature notes, .claude/, .codex/, .agents/).

/*
!/.gitignore
!/model/

/model/*
!/model/README.md
!/model/pyproject.toml
!/model/requirements.txt
!/model/src/
!/model/data_pipeline/
!/model/scripts/
!/model/tests/

/model/src/*
!/model/src/simple_agent/
!/model/src/collector/
/model/src/collector/binance_um.py

/model/scripts/*
!/model/scripts/hpo_multiyear.py
!/model/scripts/hpo_robust.py
!/model/scripts/final_report.py
!/model/scripts/paper_figures.py

/model/tests/*
!/model/tests/test_simple_agent.py
!/model/tests/test_bitmex_collector.py
!/model/tests/test_bitmex_ohlcv.py

# agent instruction and working documents, wherever they appear
CLAUDE.md
AGENTS.md
GEMINI.md
ARCHITECTURE*.md
literature.md
.claude/
.codex/
.agents/
.cursor/
.idea/

# data, secrets and generated files
*.parquet
*.csv
*.csv.gz
*.pt
*.log
.env
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.DS_Store
