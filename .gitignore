# The repository publishes only the source of the agents: the shared framework (core/), the learning algorithms
# (agents/), the data collector and feature pipeline (data_pipeline/), the walk-forward and figure scripts, and tests.
# Everything else is ignored by default: market data, results and model weights, the archive of earlier agents, and
# agent instruction or working documents (CLAUDE.md, AGENTS.md, ARCHITECTURE.md, literature notes, .claude/ ...).

/*
!/.gitignore
!/README.md
!/pyproject.toml
!/requirements.txt
!/core/
!/agents/
!/data_pipeline/
!/scripts/
!/tests/

/agents/*/results/
/data_pipeline/*.parquet

/scripts/*
!/scripts/walkforward_nested.py
!/scripts/walkforward_report.py
!/scripts/paper_figures.py
!/scripts/paper_tables.py

# agent instruction and working documents, wherever they appear
CLAUDE.md
AGENTS.md
GEMINI.md
ARCHITECTURE*.md
literature.md
.claude/
.codex/
.agents/
.cursor/
.idea/

# data, secrets and generated files
*.parquet
*.csv
*.csv.gz
*.pt
*.npz
*.npy
*.log
.env
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.DS_Store
