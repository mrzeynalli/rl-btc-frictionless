# The repository publishes only the source of Study 1 (frictionless account, recurrent PPO): the shared framework
# (core/), the learning algorithm (agents/ppo/), the data collector and feature pipeline (data_pipeline/), the
# walk-forward and paper scripts, and tests.
# Everything else is ignored by default: market data, results and model weights, backups (the archive of earlier
# agents, REINFORCE, paper revisions), side experiments, and agent instruction or working documents
# (CLAUDE.md, AGENTS.md, ARCHITECTURE.md, literature notes, .claude/ ...).

/*
!/.gitignore
!/README.md
!/pyproject.toml
!/requirements.txt
!/core/
!/agents/
!/data_pipeline/
!/scripts/
!/tests/

# named explicitly as well, so they stay out even if the rules above change
/backups/
/experiments/
/data/
/agents/reinforce/
/agents/*/results/
/data_pipeline/*.parquet

/scripts/*
!/scripts/walkforward_nested.py
!/scripts/walkforward_report.py
!/scripts/paper_figures.py
!/scripts/paper_tables.py

# agent instruction and working documents, wherever they appear
CLAUDE.md
AGENTS.md
GEMINI.md
ARCHITECTURE*.md
literature.md
.claude/
.codex/
.agents/
.cursor/
.idea/

# data, secrets and generated files
*.parquet
*.csv
*.csv.gz
*.pt
*.npz
*.npy
*.log
.env
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.DS_Store
